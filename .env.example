# ==============================================================================
# NUAS KNUST DINNER & AWARDS NIGHT PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# SAFE PLACEHOLDERS ONLY. DO NOT COMMIT ACTUAL PRODUCTION SECRETS OR PASSWORDS.
# Copy this file to .env.local for local development.
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Application Port
PORT=3000

# PostgreSQL Database Connection URL (Prisma)
# Example: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:YOUR_DEV_PASSWORD@localhost:5432/nuas_awards_dev?schema=public"

# Session Encryption Key (Minimum 32 random characters in production)
SESSION_SECRET="change-this-to-a-secure-32-char-random-string-in-production"

# Dedicated Ticket QR & Access Signing Secret (Minimum 32 characters in production)
# Independent from SESSION_SECRET to prevent cross-subsystem credential compromise
TICKET_SIGNING_SECRET="change-this-to-a-secure-32-char-ticket-signing-secret"

# Initial Super Administrator Provisioning (Used strictly by scripts/seed-admin.ts)
INITIAL_ADMIN_NAME="NUAS Executive Super Admin"
INITIAL_ADMIN_EMAIL="admin@nuasknust.org"
INITIAL_ADMIN_PASSWORD="ReplaceWithAStrongPassword123!"

# Payment Provider Configuration (Disabled by default until merchant sign-off)
# Options: 'SANDBOX_MOCK' | 'PAYSTACK' | 'HUBTEL'
PAYMENT_PROVIDER="SANDBOX_MOCK"
PAYMENT_WEBHOOK_SECRET="replace-with-webhook-secret-from-payment-provider"
PAYSTACK_SECRET_KEY="sk_test_placeholder"

# Email Delivery Configuration (Decoupled outbox pattern)
EMAIL_FROM="noreply@nuasknust.org"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""

# Media & Image Storage Configuration (Cloudinary)
# Required in production for persistent nominee avatar storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Alternative full connection URL (optional):
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# Feature Flags
ENABLE_LIVE_PAYMENTS=false
ALLOW_TEST_SEEDING=true
